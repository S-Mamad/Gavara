# Public landing URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://raxinshop.com

# Optional integrations
GITHUB_TOKEN=
GITHUB_USERNAME=

# Admin CMS
# Development defaults are OK locally. In production BOTH are required:
# - ADMIN_PASSWORD: min 12 chars, not a common weak password
# - ADMIN_SESSION_SECRET: min 24 chars, different from password
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string-at-least-24
